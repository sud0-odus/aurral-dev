diff --git a/.tests/download/pipeline-progress.test.js b/.tests/download/pipeline-progress.test.js
new file mode 100644
index 00000000..e7b9a449
--- /dev/null
+++ b/.tests/download/pipeline-progress.test.js
@@ -0,0 +1,104 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { setupIsolatedBackend, cleanupIsolatedState } from "../helpers/backendTestHarness.js";
+
+const [state, { dbOps }, { downloadTracker }, { downloadWorker }, { processPipelineJob }, guards, { getPipelineQueue, getHonkerDb }] = await setupIsolatedBackend(
+  "pipeline-progress", "backend/db/helpers/index.js", "backend/services/downloadJobs/downloadTracker.js",
+  "backend/services/downloadJobs/downloadWorker.js", "backend/services/downloadPipelineWorker.js",
+  "backend/services/downloadJobs/mutationGuards.js",
+  "backend/services/honkerDb.js",
+);
+test.after(() => cleanupIsolatedState(state));
+test.beforeEach(async () => {
+  await downloadWorker.stopAndDrain();
+  downloadTracker.clearAll();
+  const transaction = getHonkerDb().transaction();
+  transaction.execute("DELETE FROM _honker_live WHERE queue = 'slskd-pipeline'");
+  transaction.commit();
+  dbOps.updateSettings({ integrations: { ytdlp: { enabled: false } }, flows: [], sharedPlaylists: [] });
+});
+
+test("a waiting pipeline step restarts dispatch and respects the two-job admission limit", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const waiting = downloadTracker.addJob({ artistName: "Queued", trackName: "Already dispatched" }, "library");
+  downloadTracker.markSlskdDispatched(waiting);
+  const pending = Array.from({ length: 100 }, (_, i) => downloadTracker.addJob({ artistName: "Next", trackName: `Track ${i}` }, "library"));
+  downloadWorker.paused = false;
+  t.mock.method(downloadWorker, "getWorkerSettings", () => ({ concurrency: 2 }));
+  t.mock.method(downloadWorker, "scheduleReuseLinkRepair", () => {});
+  const release = Promise.withResolvers();
+  const admitted = [];
+  let maxActive = 0;
+  t.mock.method(downloadWorker, "processJob", async (job) => {
+    admitted.push(job.id);
+    maxActive = Math.max(maxActive, downloadWorker.activeCount);
+    downloadTracker.markSlskdDispatched(job.id);
+    await release.promise;
+  });
+  await processPipelineJob({ jobId: waiting, playlistId: "library", phase: "search" }, {
+    async processPipelinePayload(payload) { return { ...payload, delaySeconds: 2 }; },
+  });
+  assert.equal(admitted.length, 1, "one queued search and one admitted job fill the two-job limit");
+  release.resolve();
+  for (let step = 0; step < 500 && admitted.length < pending.length; step += 1) {
+    await new Promise(setImmediate);
+    t.mock.timers.tick(250);
+  }
+  await new Promise(setImmediate);
+  assert.equal(admitted.length, 100);
+  assert.equal(new Set(admitted).size, 100);
+  assert.equal(maxActive, 1, "the existing queued search retains its admission slot");
+  assert.ok(!admitted.includes(waiting));
+});
+
+test("a pipeline continuation does not override an explicit worker stop", async (t) => {
+  const id = downloadTracker.addJob({ artistName: "Paused", trackName: "Keep waiting" }, "library");
+  const start = t.mock.method(downloadWorker, "start", async () => {});
+  await processPipelineJob({ jobId: id, playlistId: "library" }, {
+    async processPipelinePayload() { return null; }, async continuePipeline() {},
+  });
+  assert.equal(start.mock.callCount(), 0);
+  assert.equal(downloadTracker.getJob(id).status, "pending");
+});
+
+test("six in-flight pipeline jobs apply backpressure until a slot is released", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const queue = getPipelineQueue();
+  for (let i = 0; i < 6; i++) {
+    const id = downloadTracker.addJob({ artistName: "In flight", trackName: `Transfer ${i}` }, "library");
+    downloadTracker.markSlskdDispatched(id);
+    queue.enqueue({ jobId: id, phase: "poll", playlistId: "library" });
+  }
+  downloadTracker.addJob({ artistName: "Backlog", trackName: "Next transfer" }, "library");
+  t.mock.method(downloadWorker, "getWorkerSettings", () => ({ concurrency: 2 }));
+  t.mock.method(downloadWorker, "scheduleReuseLinkRepair", () => {});
+  const process = t.mock.method(downloadWorker, "processJob", async (job) => {
+    downloadTracker.markSlskdDispatched(job.id);
+    queue.enqueue({ jobId: job.id, phase: "poll", playlistId: "library" });
+  });
+  await downloadWorker.start();
+  t.mock.timers.tick(2000);
+  await new Promise(setImmediate);
+  assert.equal(process.mock.callCount(), 0);
+  const completed = queue.claimOne("capacity-test");
+  completed.ack();
+  t.mock.timers.tick(2000);
+  await new Promise(setImmediate);
+  assert.equal(process.mock.callCount(), 1);
+});
+
+test("dispatch wakes outside the playlist lease and wake failure does not retry persisted work", async () => {
+  const id = downloadTracker.addJob({ artistName: "Lease", trackName: "Safe wake" }, "library");
+  let processed = 0;
+  let continued = 0;
+  await processPipelineJob({ jobId: id, playlistId: "library" }, {
+    async processPipelinePayload() { processed++; return null; },
+    async continuePipeline() { continued++; },
+    async startWorkerIfPending() {
+      await guards.withPlaylistMutationLock("another-owner", () => null);
+      throw new Error("disposable dispatcher failure");
+    },
+  });
+  assert.equal(processed, 1);
+  assert.equal(continued, 1);
+});
