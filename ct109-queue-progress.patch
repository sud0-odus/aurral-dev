+export async function processPipelineJob(payload, dependencies = {}) {
+  try {
+    return await withDownloadPayloadMutation(payload, (current) => processLockedPipelineJob(current, dependencies));
+  } finally {
+    // Wake dispatch after releasing the playlist lease. A waiting transfer
+    // or search may be the only work that survived an idle owner/restart.
+    // Failure to wake must not retry a step whose continuation was persisted.
+    try {
+      const startPending = dependencies.startWorkerIfPending ||
+        (await import("./downloadJobs/downloadWorker.js")).startWorkerIfPending;
+      await startPending({ respectPause: true });
+    } catch (error) {
+      logger.warn("downloads", "Could not wake pending download jobs", {
+        reason: safeLogDiagnostic(error),
+      });
+    }
+  }
 }
 
