+  const settings = dbOps.getSettings();
+  dbOps.updateSettings({ integrations: {
+    ...settings.integrations,
+    news: { ...settings.integrations.news, enabled: false },
+  } });
+  const requests = t.mock.method(axios, "get", async () => {
+    throw new Error("Disabled news must not fetch feeds or article images");
+  });
+  await newsService.refreshNewsFeeds();
+  assert.equal(requests.mock.callCount(), 0);
+  assert.deepEqual(db.prepare("SELECT * FROM news_articles").all(), before);
+});
