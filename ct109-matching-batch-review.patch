+  const message = (child, kind) => new Promise((resolve, reject) => {
+    const handler = (data) => {
+      if (data?.type === kind) { child.off("message", handler); resolve(data); }
+    };
+    child.on("message", handler);
+    child.once("error", reject);
+  });
+  await Promise.all(children.map((child) => message(child, "ready")));
+  const lock = getHonkerDb().transaction();
+  const result = children.map((child) => message(child, "result"));
+  try {
+    const calling = children.map((child) => message(child, "calling"));
+    children.forEach((child) => child.send({ playlistId: "concurrent-playlist" }));
+    await Promise.all(calling);
+    await delay(100);
+  } finally {
+    lock.commit();
+  }
+  const ids = (await Promise.all(result)).map((data) => data.id);
+  assert.equal(new Set(ids).size, 1);
+  assert.equal(listHonkerJobs("playlist-mbid-enrichment").length, 1);
+});
